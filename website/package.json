{
  "name": "xem-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "node scripts/build.mjs",
    "start": "wrangler dev --port 3002",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs",
    "capture:templates": "node scripts/capture-templates.mjs",
    "preview": "wrangler dev --port 3002",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "generate:blog-covers": "node scripts/generate-blog-covers.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.101",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/helpers": "0.2.0",
    "ai": "7.0.98",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "3.15.0",
    "lucide-react": "^0.577.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "0.186.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wrangler": "^4.130.0"
  }
}
