{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xem-website",
  "compatibility_date": "2026-09-10",
  "previews": {},
  // Newsletter websites: paths the static site doesn't have go to the Worker.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    // Customer domains share this Worker, so it decides before any asset is
    // served: news.example.com/pricing must not show xem.email's pricing.
    "run_worker_first": true
    // No not_found_handling: unknown paths must reach the Worker, which
    // serves /404 itself when there's no newsletter there either.
  },
  "vars": { "API_URL": "https://api.xem.email" }
}
