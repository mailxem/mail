{
  "name": "@xem/cloudflare-mailbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "deploy": "wrangler deploy && wrangler d1 migrations apply MAILBOX_DB --remote",
    "deploy:check": "wrangler deploy --dry-run --outdir /tmp/xem-cloudflare-mailbox-dry-run"
  },
  "pnpm": {
    "overrides": {
      "miniflare": "5.20260930.0-alpha"
    }
  },
  "dependencies": {
    "postal-mime": "4.0.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "22.19.11",
    "typescript": "7.0.2",
    "vitest": "4.1.0",
    "wrangler": "4.145.0"
  }
}
