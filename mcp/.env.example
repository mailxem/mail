# Local stdio only: credentials come from the user's MCP client environment.
XEM_API_KEY=your-workspace-api-key
# XEM_API_TOKEN=alternative-jwt-bearer-token
XEM_API_BASE_URL=https://api.xem.email/api/v1

# Hosted HTTP: never configure shared API credentials; each request provides its key.
XEM_MCP_PUBLIC_URL=https://mcp.xem.email/mcp
HOST=127.0.0.1
PORT=3000
# Optional explicit browser origin allowlist (native clients omit Origin).
# XEM_MCP_ALLOWED_ORIGINS=https://your-trusted-client.example

# Docker Compose: point this hostname's DNS at the host before starting Caddy.
MCP_DOMAIN=mcp.xem.email

# Published by GitHub Actions. Pin a release tag or digest for production.
MCP_IMAGE=ghcr.io/mailxem/mcp:main
