# Build-time browser API URL. /api/v1 uses this installation's reverse proxy.
# An absolute API URL remains supported for hosted builds.
NEXT_PUBLIC_API_URL=/api/v1
# Optional build-time billing redirect. Leave empty for self-hosted installations.
NEXT_PUBLIC_PAYWALL_URL=
# Server-only, operator-trusted backend URL. Private HTTP service addresses are allowed.
# Set at runtime, for example http://backend:9001/api/v1. Required with /api/v1 above.
# Route /api/v1/* and /public/forms/* to that backend at the public reverse proxy;
# /api/auth/* and other application routes stay on this frontend.
INTERNAL_API_URL=
NEXT_PUBLIC_APP_URL=
API_KEY_EXPIRY_DAYS=90
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Xem assistant — server-only; never prefix these with NEXT_PUBLIC_.
XEM_ASSISTANT_ENABLED=true
# Explicit opt-in for on-demand summaries of selected inbox messages.
XEM_MAIL_SUMMARY_ENABLED=false
AI_PROXY_BASE_URL=https://ai-proxy.synehq.com/v1
AI_PROXY_MODEL=gpt-4.1
ASSISTANT_TEAM_DAILY_REQUEST_LIMIT=500
AI_PROXY_API_KEY=
XEM_MCP_URL=https://mcp.xem.email/mcp
# Required in production. Use a private Redis with persistence and TLS/auth.
ASSISTANT_REDIS_URL=
