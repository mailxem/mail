                "id": "studio-newsletter-welcome-wordmark-7",
                "type": "text",
                "values": {
                  "anchor": "",
                  "displayCondition": null,
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "_meta": {
                    "htmlID": "u_content_text_1",
