                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "What do people work on?",
                  "fontSize": "20px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
                  },
                  "color": "#1E2B24",
                  "textAlign": "left",
                  "lineHeight": "110%",
                  "containerPadding": "10px 36px",
                  "headingType": "h2"
                }
