                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "What’s the hardest part?",
                  "fontSize": "20px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
