                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "How did it start?",
                  "fontSize": "20px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
                  },
                  "color": "#1E2B24",
                  "textAlign": "left",
