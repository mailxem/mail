                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "I taught myself from library books and wanted somewhere to ask questions out loud. So I booked the meeting room and put up a poster.",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
                  },
                  "color": "#1E2B24",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "10px 36px"
                }
              },
              {
                "id": "edition-member-profile-12",
