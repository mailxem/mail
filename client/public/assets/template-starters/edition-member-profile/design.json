                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "The library Wi-Fi. We now bring our own router.",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Arial",
