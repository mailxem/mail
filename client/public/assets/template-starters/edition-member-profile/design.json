                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "Personal websites, mostly. Then spreadsheets that got out of hand, and one man building a game about his allotment.",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
