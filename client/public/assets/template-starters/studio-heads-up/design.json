                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "What this means for you",
                  "fontSize": "24px",
                  "fontFamily": {
                    "label": "Helvetica",
                    "value": "helvetica,sans-serif"
                  },
                  "color": "#1A1A1A",
                  "textAlign": "left",
                  "lineHeight": "110%",
