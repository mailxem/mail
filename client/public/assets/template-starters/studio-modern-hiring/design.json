                    "htmlClassNames": "u_content_text"
                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "<strong>Tip 1: treat AI as input, not authority.</strong> Use it like a smart colleague’s opinion, not the final word.<br><br><strong>Tip 2: replace black boxes with glass boxes.</strong> Teams should be able to see how a tool reached its answer.<br><br><strong>Tip 3: check identity from start to finish.</strong> Verification shouldn’t stop at the application.<br><br><strong>Tip 4: ask for explanations.</strong> Audit trails and clear reasoning keep everyone honest.",
                  "fontSize": "12px",
                  "fontFamily": {
                    "label": "Helvetica",
                    "value": "helvetica,sans-serif"
                  },
                  "color": "#E8F0E8",
