                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "<em>“You can inspect almost anything in the game and read a little description of it. On the battlefield they’re practical. Everywhere else they’re mostly jokes. The throne and the mop bucket have the same description. Almost nobody notices.”</em>",
                  "fontSize": "12px",
                  "fontFamily": {
                    "label": "Georgia",
                    "value": "georgia,palatino"
                  },
                  "color": "#1A1A1A",
