                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "Lena has been a customer since our first year. She runs a small studio, teaches evening classes, and arranges flowers for a handful of local restaurants.",
                  "fontSize": "13px",
                  "fontFamily": {
                    "label": "Georgia",
                    "value": "georgia,palatino"
                  },
                  "color": "#E9E4D2",
                  "textAlign": "center",
