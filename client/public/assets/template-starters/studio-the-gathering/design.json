                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "Last week, we spent an afternoon at florist Lena Moss’s home studio for a guided flower-arranging class.",
                  "fontSize": "24px",
                  "fontFamily": {
                    "label": "Georgia",
                    "value": "georgia,palatino"
