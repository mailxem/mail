                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "The newest class of Obama Leaders is here!",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Georgia",
                    "value": "georgia,palatino"
                  },
                  "color": "#30332F",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "10px 45px"
                }
              },
              {
                "id": "meet-the-leaders-8",
                "type": "text",
                "values": {
                  "anchor": "",
                  "displayCondition": null,
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "_meta": {
                    "htmlID": "u_content_text_2",
                    "htmlClassNames": "u_content_text"
                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "President Obama champions the fundamental belief that change doesn’t come from the top down—it belongs to the next generation of leaders. Through the Obama Leaders Program, an eight-month leadership development initiative, The Obama Foundation equips changemakers ages 25–44 across the government, business, and civil society sectors with values-based leadership skills and a network of support.",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Georgia",
                    "value": "georgia,palatino"
                  },
                  "color": "#30332F",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "10px 45px"
                }
              },
              {
                "id": "meet-the-leaders-9",
                "type": "text",
                "values": {
                  "anchor": "",
                  "displayCondition": null,
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "_meta": {
                    "htmlID": "u_content_text_3",
                    "htmlClassNames": "u_content_text"
                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "Now, 155 leaders from 64 nations and territories will learn from each other, embrace new perspectives, and gain the tools they need to turn hope into action.",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Georgia",
                    "value": "georgia,palatino"
                  },
                  "color": "#30332F",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "10px 45px"
                }
              },
              {
