                  },
                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "<a href=\"https://example.com\" style=\"color:#C8503A;\">One of my favourite ideas in nutrition</a> is simple: the good things in food work best together. When one ingredient is taken out of the food and put in a pill, it often doesn’t work as well.<br><br>Whole food arrives as a package: fibre, colour, and hundreds of compounds we still don’t fully understand.<br><br><strong>We can copy one ingredient. We still can’t copy an apple.</strong>",
                  "fontSize": "13px",
                  "fontFamily": {
                    "label": "Helvetica",
                    "value": "helvetica,sans-serif"
                  },
                  "color": "#1A1A1A",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "4px 32px 16px"
                }
