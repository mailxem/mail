                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "Hello friend,<br><br>Powders. Supplements. Gummies with a vitamin for everything.<br><br>But for all the clever new things, I think the most powerful daily habit might still be dinner.",
                  "fontSize": "13px",
                  "fontFamily": {
                    "label": "Helvetica",
                    "value": "helvetica,sans-serif"
                  },
                  "color": "#1A1A1A",
