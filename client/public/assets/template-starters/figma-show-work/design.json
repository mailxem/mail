                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "<strong>2</strong> &nbsp; We’ve all heard how AI is shifting responsibilities, but what does that actually look like? An engineer, designer, and product manager share <strong><u>how building nested folders in Figma gave them a new outlook on their roles.</u></strong>",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
                  },
                  "color": "#30332F",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "12px 30px"
                }
              },
