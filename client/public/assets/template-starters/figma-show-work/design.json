                  "linkStyle": {
                    "inherit": true,
                    "linkColor": "#514293",
                    "linkHoverColor": "#514293",
                    "linkUnderline": true,
                    "linkHoverUnderline": true
                  },
                  "text": "<strong>1</strong> &nbsp; Digital tools make it easy to produce something slick—but for Config 2026, our Brand Studio used Figma Make to help create <strong><u>a visual language that was perfectly imperfect.</u></strong>",
                  "fontSize": "16px",
                  "fontFamily": {
                    "label": "Arial",
                    "value": "arial,helvetica,sans-serif"
                  },
                  "color": "#30332F",
                  "textAlign": "left",
                  "lineHeight": "160%",
                  "containerPadding": "12px 30px"
