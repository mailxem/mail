                    "borderTopColor": "#0CA95A"
                  },
                  "textAlign": "center",
                  "containerPadding": "18px 36px"
                }
              },
              {
                "id": "figma-show-work-21",
                "type": "text",
                "values": {
                  "anchor": "",
                  "displayCondition": null,
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "_meta": {
                    "htmlID": "u_content_text_7",
