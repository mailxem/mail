              {
                "id": "studio-artist-welcome-9",
                "type": "text",
                "values": {
                  "anchor": "",
                  "displayCondition": null,
                  "selectable": true,
                  "draggable": true,
                  "duplicatable": true,
                  "deletable": true,
                  "hideable": true,
                  "_meta": {
                    "htmlID": "u_content_text_1",
