                  "color": "#50574b",
                  "containerPadding": "12px 32px",
                  "fontSize": "16px",
                  "lineHeight": "175%",
                  "text": "\u003ch1 style=\"margin:0;font-size:34px;line-height:1.15;letter-spacing:-1px;color:#181a16\"\u003eYour test is on its way.\u003c/h1\u003e"
                }
              },
              {
                "id": "onboarding-text-3",
                "type": "text",
                "values": {
                  "_meta": {
                    "htmlID": "u_content_text_4"
                  },
                  "color": "#50574b",
                  "containerPadding": "12px 32px",
                  "fontSize": "16px",
                  "lineHeight": "175%",
                  "text": "\u003cp style=\"margin:0;color:#50574b;line-height:1.75\"\u003eThe email provider accepted your test for sending. This is not yet confirmation that the receiving server accepted it.\u003c/p\u003e"
                }
              },
              {
                "id": "onboarding-text-4",
                "type": "text",
                "values": {
