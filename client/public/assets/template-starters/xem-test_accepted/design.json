                  },
                  "color": "#50574b",
                  "containerPadding": "12px 32px",
                  "fontSize": "16px",
                  "lineHeight": "175%",
                  "text": "\u003cp style=\"margin:0;color:#6b7165;font-size:11px;letter-spacing:2px\"\u003eYOUR MANAGED SENDING JOURNEY\u003c/p\u003e"
                }
              },
