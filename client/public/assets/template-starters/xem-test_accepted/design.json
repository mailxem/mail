                  "containerPadding": "12px 32px",
                  "fontSize": "16px",
                  "lineHeight": "175%",
                  "text": "\u003cp style=\"margin:8px 0\"\u003e\u003ca href=\"https://app.xem.email/settings/sending\" style=\"display:inline-block;padding:15px 24px;background:#d2f159;color:#1c2413;font-weight:600;text-decoration:none;border-radius:8px\"\u003eOpen managed sending \u0026rarr;\u003c/a\u003e\u003c/p\u003e"
                }
