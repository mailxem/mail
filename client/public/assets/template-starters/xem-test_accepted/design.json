                    "htmlID": "u_content_text_5"
                  },
                  "color": "#50574b",
                  "containerPadding": "12px 32px",
                  "fontSize": "16px",
                  "lineHeight": "175%",
                  "text": "\u003cp style=\"margin:0;padding:16px;background:#f4f6ef;border-radius:8px;color:#42483d;font-size:13px\"\u003eWorkspace: \u003cstrong\u003e{{workspace_name}}\u003c/strong\u003e\u003cbr\u003eDomain: \u003cstrong\u003e{{domain}}\u003c/strong\u003e\u003c/p\u003e"
                }
              },
              {
                "id": "onboarding-text-5",
                "type": "text",
                "values": {
                  "_meta": {
                    "htmlID": "u_content_text_6"
                  },
                  "color": "#50574b",
                  "containerPadding": "12px 32px",
                  "fontSize": "16px",
                  "lineHeight": "175%",
                  "text": "\u003cp style=\"margin:0;color:#50574b;line-height:1.75\"\u003e\u003cstrong style=\"color:#181a16\"\u003eUp next\u003c/strong\u003e\u003cbr\u003eCheck delivery events in your workspace and look in your inbox and spam folder.\u003c/p\u003e"
                }
              },
