# Copied to .env by scripts/compose-env.sh, which also fills in the credentials below.
# Keep .env and back it up: the database password and RSA key cannot be regenerated.

# Origins your browser uses. Containers call the storage origin too, so use the
# server's LAN IP or DNS name, never localhost. Behind a TLS proxy, use https:// origins.
# Changing XEM_API_URL or XEM_APP_URL needs a rebuild: docker compose up -d --build
XEM_APP_URL=http://192.0.2.10:3000
XEM_API_URL=http://192.0.2.10:9001
XEM_STORAGE_URL=http://192.0.2.10:9000
# Published host ports (defaults 3000, 9001, 9000). Keep them in step with the URLs above.
# XEM_APP_PORT=3000
# XEM_API_PORT=9001
# XEM_STORAGE_PORT=9000

# Generated: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
AUTH_SECRET=
STORAGE_PASSWORD=
# Generated: openssl genrsa 2048 | base64 | tr -d '\n'
PRIVATE_KEY=
