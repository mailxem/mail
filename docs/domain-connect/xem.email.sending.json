{
  "providerId": "xem.email",
  "providerName": "Xem",
  "logoUrl": "https://app.xem.email/android-chrome-512x512.png",
  "version": 1,
  "syncBlock": false,
  "syncPubKeyDomain": "xem.email",
  "syncRedirectDomain": "app.xem.email",
  "serviceId": "sending",
  "serviceName": "Send email with Xem",
  "description": "Adds the ownership, DKIM and bounce-domain records Xem needs to send from this domain.",
  "records": [
    {
      "type": "TXT",
      "host": "_xem",
      "data": "%token%",
      "ttl": 3600,
      "txtConflictMatchingMode": "None"
    },
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 3600
    },
    {
      "type": "MX",
      "host": "bounce",
      "pointsTo": "feedback-smtp.%region%.amazonses.com",
      "priority": 10,
      "ttl": 3600
    },
    {
      "type": "SPFM",
      "host": "bounce",
      "spfRules": "include:amazonses.com"
    }
  ]
}
