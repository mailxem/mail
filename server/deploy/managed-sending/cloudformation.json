{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Xem managed sending: SES feedback topic, HTTPS subscription, and restricted runtime policy. No SMTP credentials or AWS access keys are created.",
  "Parameters": {
    "RuntimeRoleName": {
      "Type": "String",
      "Description": "Name of an existing backend IAM role; this template does not change its trust policy.",
      "AllowedPattern": "[A-Za-z0-9+=,.@_-]{1,64}"
    },
    "FeedbackEndpoint": {
      "Type": "String",
      "Default": "",
      "Description": "Leave blank on first deploy. After configuring Xem, update with https://API_HOST/api/v1/sending/events/ses.",
      "AllowedPattern": "^$|^https://[^/]+/api/v1/sending/events/ses$"
    },
    "CreateEventsQueue": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "true adds an SQS queue (and dead-letter queue) subscribed to the feedback topic. Set the backend's SES_EVENTS_QUEUE_URL to the FeedbackQueueURL output."
    },
    "AlarmTopicArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^arn:[a-z0-9-]+:sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_.-]+$",
      "Description": "Existing operator SNS topic for feedback queue alarm and recovery notifications."
    }
  },
  "Conditions": {
    "HasEndpoint": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "FeedbackEndpoint"
            },
            ""
          ]
        }
      ]
    },
    "HasEventsQueue": {
      "Fn::Equals": [
        {
          "Ref": "CreateEventsQueue"
        },
        "true"
      ]
    },
    "HasAlarmTopic": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AlarmTopicArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "FeedbackTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "DisplayName": "Xem managed delivery feedback"
      }
    },
    "FeedbackTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "FeedbackTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlySESFromThisAccount",
              "Effect": "Allow",
              "Principal": {
                "Service": "ses.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "FeedbackTopic"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/xem-*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "FeedbackSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasEndpoint",
      "DependsOn": "FeedbackTopicPolicy",
      "Properties": {
        "Protocol": "https",
        "Endpoint": {
          "Ref": "FeedbackEndpoint"
        },
        "TopicArn": {
          "Ref": "FeedbackTopic"
        },
        "RawMessageDelivery": false
      }
    },
    "RuntimePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "SES operations required by Xem, scoped to this account/region and Xem tenants/configuration sets.",
        "Roles": [
          {
            "Ref": "RuntimeRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ConfigurationSets",
              "Effect": "Allow",
              "Action": [
                "ses:CreateConfigurationSet",
                "ses:CreateConfigurationSetEventDestination",
                "ses:UpdateConfigurationSetEventDestination"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/xem-*"
              }
            },
            {
              "Sid": "DomainIdentities",
              "Effect": "Allow",
              "Action": [
                "ses:CreateEmailIdentity",
                "ses:GetEmailIdentity",
                "ses:PutEmailIdentityMailFromAttributes"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
              }
            },
            {
              "Sid": "WorkspaceTenants",
              "Effect": "Allow",
              "Action": [
                "ses:CreateTenant"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:tenant/xem-*"
              }
            },
            {
              "Sid": "TenantAssociations",
              "Effect": "Allow",
              "Action": [
                "ses:CreateTenantResourceAssociation"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:tenant/xem-*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/xem-*"
                }
              ]
            },
            {
              "Sid": "ManagedDelivery",
              "Effect": "Allow",
              "Action": [
                "ses:SendEmail",
                "ses:SendRawEmail"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/xem-*"
                }
              ],
              "Condition": {
                "StringLike": {
                  "ses:TenantName": "xem-*"
                }
              }
            },
            {
              "Fn::If": [
                "HasEventsQueue",
                {
                  "Sid": "ConsumeFeedbackQueue",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "FeedbackQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "FeedbackDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "HasEventsQueue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "FeedbackQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "HasEventsQueue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "ReceiveMessageWaitTimeSeconds": 20,
        "VisibilityTimeout": 60,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "FeedbackDeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "FeedbackQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Condition": "HasEventsQueue",
      "Properties": {
        "Queues": [
          {
            "Ref": "FeedbackQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": {
                "Fn::GetAtt": [
                  "FeedbackQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "OnlyTheFeedbackTopic",
              "Effect": "Allow",
              "Principal": {
                "Service": "sns.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": {
                "Fn::GetAtt": [
                  "FeedbackQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Ref": "FeedbackTopic"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "FeedbackQueueSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasEventsQueue",
      "DependsOn": "FeedbackQueuePolicy",
      "Properties": {
        "Protocol": "sqs",
        "Endpoint": {
          "Fn::GetAtt": [
            "FeedbackQueue",
            "Arn"
          ]
        },
        "TopicArn": {
          "Ref": "FeedbackTopic"
        },
        "RawMessageDelivery": false
      }
    },
    "FeedbackDeadLetterAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "HasEventsQueue",
      "Properties": {
        "AlarmDescription": "SES feedback that failed 5 times is waiting in the dead-letter queue: bounces or complaints may be unrecorded.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "FeedbackDeadLetterQueue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "DatapointsToAlarm": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "OKActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "FeedbackBacklogAgeAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Condition": "HasEventsQueue",
      "Properties": {
        "AlarmDescription": "SES feedback has waited over 10 minutes in the queue: the backend may not be reading it.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateAgeOfOldestMessage",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "FeedbackQueue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "DatapointsToAlarm": 2,
        "Threshold": 600,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "OKActions": {
          "Fn::If": [
            "HasAlarmTopic",
            [
              {
                "Ref": "AlarmTopicArn"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "TopicARN": {
      "Value": {
        "Ref": "FeedbackTopic"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "AccountID": {
      "Value": {
        "Ref": "AWS::AccountId"
      }
    },
    "RuntimePolicyARN": {
      "Value": {
        "Ref": "RuntimePolicy"
      }
    },
    "FeedbackQueueURL": {
      "Condition": "HasEventsQueue",
      "Value": {
        "Ref": "FeedbackQueue"
      }
    }
  }
}
