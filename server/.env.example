# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kori
POSTGRES_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-secret-key

# S3-compatible storage is required; self-hosted MinIO is supported.
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_QUEUE_SIZE=100

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0

PRIVATE_KEY=

# Firebase Configuration
FIREBASE_CONFIG_DATA=your-firebase-config

# Dodo Payments Configuration
DODO_API_KEY=your_dodo_api_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
APP_ENV=development # or production

# Exact browser origins allowed to call the API (comma-separated).
# Self-hosted installations should replace these with their own app origins.
CORS_ALLOWED_ORIGINS=https://app.xem.email,http://localhost:3000

# Managed sending is opt-in; use AWS's default credential chain / IAM role.
MANAGED_SENDING_ENABLED=false
# Owner milestone emails use the platform SMTP_* configuration, not tenant SMTP.
MANAGED_NOTIFICATIONS_ENABLED=false
DASHBOARD_URL=https://app.xem.email
MANAGED_SES_REGION=
MANAGED_AWS_ACCOUNT_ID=
MANAGED_SNS_TOPIC_ARN=
MANAGED_MAX_MESSAGE_BYTES=5242880
MANAGED_DAILY_LIMIT=200
MANAGED_MONTHLY_LIMIT=1000
# Conservative reserved allowance; not a billing rate or final invoice.
MANAGED_MONTHLY_BUDGET_MICROS=1000000
MANAGED_COST_PER_RECIPIENT_MICROS=1000
MANAGED_QUEUE_LIMIT=1000

# Public SMTP submission is separately opt-in and always requires TLS.
MANAGED_SMTP_ENABLED=false
MANAGED_SMTP_ADDR=:587
MANAGED_SMTP_HOST=
MANAGED_SMTP_TLS_CERT=
MANAGED_SMTP_TLS_KEY=
# Self-hosted LAN relay support only. Hosted deployments should leave this false.
ALLOW_PRIVATE_SMTP=false

# Optional full endpoint origin for self-hosted S3-compatible storage (path-style).
# Must be reachable by the backend. Browsers also use it unless the public
# endpoint override below is configured.
# When set, S3_REGION is also used as the signing region (e.g. us-east-1).
S3_ENDPOINT_URL=

# Optional HTTPS origin for browser object URLs when S3_ENDPOINT_URL is private.
# For MinIO behind the application proxy, use the public HTTPS site origin.
# Preserve the complete Host (including port), bucket path and query at the proxy.
# Leave unset when browsers should use S3_ENDPOINT_URL directly.
S3_PUBLIC_ENDPOINT_URL=

# Omit object ACL headers for MinIO, ACL-disabled S3, or private R2 buckets.
# The existing bucket policy still applies. False preserves hosted ACL behavior.
S3_DISABLE_ACL=false

# Optional initialization for dedicated MinIO or a compatible object store.
# Only NoSuchBucket allows creation; no policy/ACL is changed. Checks are bounded
# to 30 seconds, and existing buckets or access-denied errors are never replaced.
# No AWS LocationConstraint is sent: provision AWS S3 buckets separately and
# keep this false for AWS S3 and all pre-provisioned external buckets.
S3_CREATE_BUCKET=false

# Optional Gmail / Google Workspace mailbox OAuth (separate from Google sign-in).
# Enable Gmail API and register this exact client callback on the Google OAuth app.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REDIRECT_URI=http://localhost:3000/settings/imap/google/callback
# Keep hosted mailbox access limited until Google's applicable approval is complete.
# testing (default), disabled, public (verified hosted app), or self-hosted (own OAuth app).
GOOGLE_MAIL_ACCESS=testing
GOOGLE_MAIL_TEST_USERS=
# Explicitly allow private IMAP servers; certificate validation remains required.
ALLOW_PRIVATE_IMAP=false
