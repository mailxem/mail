# Server Configuration
PORT=8080
ENVIRONMENT=development

# Database Configuration
# Production: Use sslmode=require for security
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/payments_db?sslmode=disable

# Dodo Payments Configuration
# Get these from https://dodopayments.com/dashboard
DODO_API_KEY=your-dodo-api-key-here
DODO_TEST_MODE=true
DODO_WEBHOOK_SECRET=your-dodo-webhook-secret-here

# Security - CRITICAL: Generate strong random secrets for production
# Generate with: openssl rand -base64 32
# Production: Must be 32+ characters, no default values
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_SECRET=your-admin-secret-min-32-chars

# CORS - Restrict to your actual frontend domains
# Production: Use https:// URLs only
FRONTEND_URL=http://localhost:3000

# Plans Configuration
FREE_PLAN_ID=starter-plan-001

# Dashboard URL
DASHBOARD_URL=http://localhost:3000

# Email Service Configuration (Kori/Posthoot)
KORI_EMAIL_API_URL=https://api.posthoot.com/v1
KORI_EMAIL_API_KEY=your-kori-api-key-here
KORI_EMAIL_PROVIDER=AMAZON

# Email Template IDs
FREE_TRIAL_START_TEMPLATE_ID=your-template-id
FREE_TRIAL_END_IS_GOING_TO_END_SOON_TEMPLATE_ID=your-template-id
FREE_TRIAL_END_TEMPLATE_ID=your-template-id
SUBSCRIPTION_STATUS_CHANGED_TEMPLATE_ID=your-template-id
PRO_PLAN_ACTIVATED_TEMPLATE_ID=your-template-id
